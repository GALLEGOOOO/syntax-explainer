{
  "name": "syntax-explainer",
  "displayName": "Syntax Explainer",
  "description": "Explicaciones en español de palabras clave, funciones y etiquetas al pasar el ratón, para 20 lenguajes y formatos más React, Vue y Angular: JavaScript, TypeScript, React, Vue, Angular, HTML, CSS, Python, Java, C, C++, C#, Go, Rust, PHP, SQL y más. Ideal para aprender a programar.",
  "version": "0.3.2",
  "publisher": "GALLEGOSSJ",
  "author": "GALLEGOSSJ",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/GALLEGOOOO/syntax-explainer"
  },
  "homepage": "https://github.com/GALLEGOOOO/syntax-explainer#readme",
  "bugs": {
    "url": "https://github.com/GALLEGOOOO/syntax-explainer/issues"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "español",
    "spanish",
    "explicación",
    "hover",
    "palabras clave",
    "keywords",
    "aprender",
    "principiantes",
    "javascript",
    "typescript",
    "react",
    "html",
    "css",
    "php",
    "python",
    "java",
    "sql",
    "vue",
    "angular",
    "csharp",
    "c++",
    "go",
    "rust",
    "kotlin",
    "swift",
    "dart",
    "bash",
    "yaml",
    "markdown"
  ],
  "galleryBanner": {
    "color": "#0b0b0f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:html",
    "onLanguage:vue",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:php",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:sql",
    "onLanguage:csharp",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:kotlin",
    "onLanguage:swift",
    "onLanguage:dart",
    "onLanguage:shellscript",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml",
    "onLanguage:markdown"
  ],
  "contributes": {
    "configuration": {
      "title": "Syntax Explainer",
      "properties": {
        "syntaxExplainer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar explicaciones en español al pasar el ratón sobre palabras clave."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/sanity.js"
  }
}
